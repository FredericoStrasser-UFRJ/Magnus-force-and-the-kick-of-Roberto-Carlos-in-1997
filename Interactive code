field_x = np.linspace(-10, 10, 2)
field_y = np.linspace(0, 40, 2)
X, Y = np.meshgrid(field_x, field_y)
Z = np.zeros_like(X)
ax.plot_surface(
    X,
    Y,
    Z,
    color="green",
    alpha=0.3
)
# Goal
ax.plot([2.5, 2.5], [35, 35], [0, 2], color="black")
ax.plot([-2.5, -2.5], [35, 35], [0, 2], color="black")
ax.plot([2.5, -2.5], [35, 35], [2, 2], color="black")
ax.set_xlabel("X position (m)")
ax.set_ylabel("Y position (m)")
ax.set_zlabel("Z position (m)")
