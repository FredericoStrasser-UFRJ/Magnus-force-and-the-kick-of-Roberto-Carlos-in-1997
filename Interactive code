import numpy as np
import matplotlib.pyplot as plt

from scipy.integrate import solve_ivp
from matplotlib.widgets import Slider, Button



# Differential equation
def dydt(t, state, w):
    position = state[:3]
    velocity = state[3:]
    #Drag force
    Cd = 0.47
    #Magnus coeficient
    Cl = 0.2
    #Air density
    rho = 1.2
    #Ball's mass
    mass = 0.43
    #Area of a ball's section
    area = 0.038
    gravity = np.array([0.0, 0.0, -9.81])
    drag_force = (
        -0.5
        * Cd
        * rho
        * area
        * np.linalg.norm(velocity)
        * velocity
    )
    magnus_force = (
        0.5
        * Cl
        * rho
        * area
        * np.cross(w, velocity)
    )
    acceleration = gravity + (drag_force + magnus_force) / mass
    return np.concatenate([velocity, acceleration])

# Stop the simulation when the ball reaches the ground
def hit_ground(t, state, w):
    return state[2]
hit_ground.terminal = True
hit_ground.direction = -1

# Run one simulation
def simulate(v0, w):
    r0 = np.array([0.0, 0.0, 0.0])
    initial_state = np.concatenate([r0, v0])
    #Defines the time interval 
    t_eval = np.linspace(0, 10, 1000)
    solution = solve_ivp(
        dydt,
        t_span=(0, 10),
        y0=initial_state,
        t_eval=t_eval,
        args=(w,),
        events=hit_ground
    )
    position = solution.y[:3]
    return solution.t, position



# Initial values
initial_velocity = np.array([0.0, 40.0, 10.0])
initial_rotation = np.array([0.0, 0.0, 0.0])
time, position = simulate(initial_velocity, initial_rotation)

# Create figure
