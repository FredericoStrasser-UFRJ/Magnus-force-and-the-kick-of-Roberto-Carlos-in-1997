ax.set_ylim(0, 40)
ax.set_zlim(0, 15)
ax.view_init(elev=15, azim=90)


# Info
information = ax.text2D(
    0.02,
    0.95,
    "",
    transform=ax.transAxes
)

# Sliders
slider_color = "#c8d8e8"

ax_vx = fig.add_axes([0.20, 0.27, 0.58, 0.025], facecolor=slider_color)
ax_vy = fig.add_axes([0.20, 0.23, 0.58, 0.025], facecolor=slider_color)
ax_vz = fig.add_axes([0.20, 0.19, 0.58, 0.025], facecolor=slider_color)

ax_wx = fig.add_axes([0.20, 0.14, 0.58, 0.025], facecolor=slider_color)
ax_wy = fig.add_axes([0.20, 0.10, 0.58, 0.025], facecolor=slider_color)
ax_wz = fig.add_axes([0.20, 0.06, 0.58, 0.025], facecolor=slider_color)

slider_vx = Slider(ax_vx, "vx", -20, 20, valinit=0)
slider_vy = Slider(ax_vy, "vy", 0, 60, valinit=40)
slider_vz = Slider(ax_vz, "vz", 0, 30, valinit=10)

slider_wx = Slider(ax_wx, "ωx", -100, 100, valinit=0)
slider_wy = Slider(ax_wy, "ωy", -100, 100, valinit=0)
slider_wz = Slider(ax_wz, "ωz", -100, 100, valinit=0)



# Button
def update(event):
    v0 = np.array([
        slider_vx.val,
        slider_vy.val,
        slider_vz.val
    ])

    w = np.array([
        slider_wx.val,
        slider_wy.val,
        slider_wz.val
    ])

    time, new_position = simulate(v0, w)

    trajectory.set_data(
        new_position[0],
        new_position[1]
    )

    trajectory.set_3d_properties(new_position[2])

    information.set_text(
        f"Flight time: {time[-1]:.2f} s\n"
        f"Final position: "
        f"({new_position[0, -1]:.1f}, "
        f"{new_position[1, -1]:.1f}, "
        f"{new_position[2, -1]:.1f}) m"
    )

    fig.canvas.draw_idle()


button_axis = fig.add_axes([0.82, 0.12, 0.12, 0.06])
simulate_button = Button(button_axis, "Simulate")

simulate_button.on_clicked(update)

update(None)

plt.show()
